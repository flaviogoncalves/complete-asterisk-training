# Build outputs (regenerated by CI)
build/
# ...but lab-vm/build/ is source: the scripts that create, verify and publish
# the lab appliance. Not an output, and not regenerable.
!lab-vm/build/

# Raw PDF extraction dumps (derivable from extract.py; bulky)
src/raw/

# OS / editor noise
.DS_Store
*.swp

# Lab runtime
lab/**/*.log

# Lab VM appliance — 800 MB, over GitHub's file limit. Built by
# lab-vm/build/export-ova.sh and served from R2; only the checksum is tracked.
*.ova

# TLS keys (generate locally with lab/make-certs.sh)
lab/asterisk/etc/keys/

# DOCX media working cache (regenerate via pandoc --extract-media; final images go in src/images/)
src/docx-media/

# Trashcan — retired files kept locally, out of the repo
.trash/

# Secrets — never commit
.env
.env.*
!.env.example

# Provider production config (reference only — contains third-party secrets/numbers)
/sip.conf
/extensions.conf

# Slidev
slides/node_modules/
slides/dist*/
slides/.slidev/
.claude/scheduled_tasks.lock

# local gstack security reports / artifacts
.gstack/
